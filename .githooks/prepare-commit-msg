#!/bin/sh
# prepare-commit-msg — append the gate scoreboard to every commit message.
#
# DEC-33 (2026-09-20, AUTHOR): commits here carry a scoreboard — Lean library
# compilation, sorry-free status, axiom list — read from docs/certificate.json,
# which `make check` writes.
#
# Three rules this obeys:
#   * it never blocks a commit. A missing or unreadable certificate yields a line
#     saying so, not a failure.
#   * it does not dress `gates_green` up as a checked fact. That field is true by
#     construction (certificate.py runs last in `make check`, so its existence is
#     the claim), and the scoreboard says so.
#   * freshness is asked of the repository's own predicate,
#     `scripts/certificate.py --verify`, not of a heuristic here: it compares the
#     worktree against the certified source commit and checks the facts file and
#     the axiom set. `pre-push` re-runs the whole gate, and that is what certifies
#     a push.

set -u
MSG="$1"
SRC="${2:-}"

[ "$SRC" = "merge" ] && exit 0
[ "$SRC" = "squash" ] && exit 0
grep -q '^Scoreboard' "$MSG" 2>/dev/null && exit 0

python3 - "$MSG" <<'PY' || exit 0
import io, json, os, subprocess, sys

msg_path = sys.argv[1]

def sh(*a, **kw):
    try:
        return subprocess.run(a, capture_output=True, text=True, timeout=60, **kw)
    except Exception:
        return None

top = sh("git", "rev-parse", "--show-toplevel")
root = top.stdout.strip() if top and top.returncode == 0 else "."
cert_path = os.path.join(root, "docs", "certificate.json")

lines = []
try:
    c = json.load(io.open(cert_path, encoding="utf-8"))
except Exception:
    lines = ["Scoreboard unavailable — docs/certificate.json unreadable; run `make check`."]
else:
    gates = c.get("gates") or []
    ax = c.get("standard_axioms") or []
    off = c.get("facts", {}).get("declarations_on_nonstandard_axioms") or []
    ml = (c.get("mathlib") or {}).get("rev", "")[:8]
    dirty = c.get("dirty")
    dfs = c.get("dirty_files") or []

    where = c.get("commit_short", "?")
    tree = ("dirty: " + ", ".join(dfs[:3])) if dirty else "clean"
    lines.append("Scoreboard — docs/certificate.json @ %s (%s)" % (where, tree))
    lines.append("  gate     lake build %s green · %d/%d · recorded by construction, not asserted"
                 % (c.get("strict_library", "GFNBounds"), len(gates), len(gates)))

    v = sh(sys.executable, os.path.join(root, "scripts", "certificate.py"), "--verify", cwd=root)
    if v is None:
        lines.append("  fresh    unknown — could not run certificate.py --verify")
    elif v.returncode == 0:
        lines.append("  fresh    certificate.py --verify: PASS")
    else:
        probs = [l.strip().replace("certificate: ", "")
                 for l in (v.stderr or "").splitlines() if l.strip()]
        lines.append("  fresh    certificate.py --verify: FAIL — %s"
                     % (probs[0] if probs else "see `make check`"))
        for p in probs[1:3]:
            lines.append("           %s" % p)

    lines.append("  sorries  strict 0 (a sorry is a compile error there) · scaffold %s"
                 % c.get("scaffold_sorries", "?"))
    lines.append("  axioms   %s · %d declaration(s) off them" % (", ".join(ax), len(off)))
    lines.append("  pin      %s · mathlib %s" % (c.get("toolchain", "?"), ml))
    lines.append("  decls    %s" % c.get("facts", {}).get("declarations", "?"))

block = "\n".join(lines)

raw = io.open(msg_path, encoding="utf-8").read().split("\n")
body, comments = [], []
for ln in raw:
    (comments if ln.startswith("#") else body).append(ln)

def is_trailer(s):
    if ":" not in s or s.startswith(" "):
        return False
    k = s.split(":", 1)[0]
    return k and all(ch.isalnum() or ch == "-" for ch in k)

end = len(body)
while end > 0 and body[end - 1].strip() == "":
    end -= 1
start = end
while start > 0 and is_trailer(body[start - 1].strip()):
    start -= 1

if start < end:
    out = body[:start] + [block, ""] + body[start:end] + body[end:]
else:
    out = body[:end] + ["", block] + body[end:]

io.open(msg_path, "w", encoding="utf-8").write("\n".join(out + comments))
PY
